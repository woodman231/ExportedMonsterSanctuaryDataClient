{
  "name": "@woodman231/exportedmonstermanctuarydataclient",
  "version": "3.1.0",
  "description": "A client for the Exported Monster Sanctuary Data.",
  "author": "Sean Woodward <seanwoodward@live.com>",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "/dist"
  ],
  "engines": {
    "node": ">=18.12.1"
  },
  "engineStrict": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/woodman231/ExportedMonsterSanctuaryDataClient"
  },
  "homepage": "https://github.com/woodman231/ExportedMonsterSanctuaryDataClient",
  "scripts": {
    "build": "tsup",
    "build:dev": "tsup --watch",
    "start": "node ./dist/index.js",
    "test": "jest",
    "release": "ts-node ./tasks/run-release.ts"
  },
  "peerDependencies": {
    "@woodman231/exportedmonstersanctuarydata": "^1.0.1",
    "@woodman231/exportedmonstersanctuarydatatypes": "^3.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.2.5",
    "@types/node": "^20.17.9",
    "@types/sinon": "^10.0.13",
    "@woodman231/exportedmonstersanctuarydata": "^1.0.1",
    "@woodman231/exportedmonstersanctuarydatatypes": "^3.0.0",
    "jest": "^29.3.1",
    "sinon": "^15.0.1",
    "ts-jest": "^29.0.3",
    "ts-node": "^10.9.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }  
}
